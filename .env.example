# Copie este arquivo como .env. Não publique o .env.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/estoque.sqlite
BACKUP_DIR=./backups
# Em desenvolvimento, pode permanecer http://localhost:3000.
# Para publicar, configure o domínio HTTPS real.
APP_URL=http://localhost:3000
# Configure como 1 SOMENTE se houver exatamente um proxy confiável à frente.
TRUST_PROXY=0
